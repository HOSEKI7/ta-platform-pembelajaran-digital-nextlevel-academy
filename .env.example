# =============================================================================
# NextLevel Academy — Environment Variables
# Copy this file to .env.local and fill in real values for local development.
# =============================================================================

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (Supabase PostgreSQL) ------------------------------------------
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (used by Prisma migrations / Prisma Studio)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ---- Supabase (Storage / public client) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Public bucket used for user avatars (defaults to "avatars" if unset).
# Create the bucket in the Supabase dashboard and mark it as Public.
SUPABASE_AVATAR_BUCKET="avatars"

# ---- Better Auth -------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ---- Resend (Transactional Email) --------------------------------------------
# Free plan + no verified domain: use "onboarding@resend.dev" as the From
# address. With this setup Resend will ONLY deliver to the email address that
# owns the Resend account; sends to any other recipient return HTTP 403.
# To send to arbitrary recipients, verify a domain at resend.com/domains.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="NextLevel Academy <onboarding@resend.dev>"

# ---- Bunny.net Stream (Video) ------------------------------------------------
# Setup:
#   1. Sign up at https://bunny.net and create a Stream Video Library
#   2. From the library dashboard, copy:
#        - Library ID (number, shown in the sidebar)            -> BUNNY_STREAM_LIBRARY_ID
#        - CDN Hostname ("vz-...b-cdn.net" in library settings) -> BUNNY_STREAM_CDN_HOSTNAME
#        - API Key (Settings -> API)                             -> BUNNY_STREAM_API_KEY (optional for now)
#   3. (Recommended) Enable Settings -> Security -> Token Authentication,
#      then copy the "Token Authentication Key"                  -> BUNNY_STREAM_TOKEN_AUTH_KEY
#      If left empty, the player loads the iframe without a token (use only in dev).
BUNNY_STREAM_LIBRARY_ID="123456"
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxxxxx-xxx.b-cdn.net"
BUNNY_STREAM_TOKEN_AUTH_KEY=""

# ---- Bunny.net Storage (file blobs — task submissions, mentor attachments) ---
# Used by /internship/tasks for storing task submission files. Postgres (Supabase)
# only stores metadata/paths; physical blobs live here (cheaper + no 1 GB limit).
# Setup:
#   1. Bunny dashboard → Storage → Add Storage Zone. Note Zone name + Password (=AccessKey).
#   2. Bunny dashboard → CDN → Add Pull Zone pointing at the Storage Zone origin.
#      Note its hostname (e.g. "nla-internship.b-cdn.net").
#   3. (REQUIRED for private submissions) Pull Zone → Security → Token Authentication = ON.
#      Copy the Authentication Key. Also enable "Block Direct File Access".
# Leave blank in dev: uploads will fail with a clear "not configured" error.
BUNNY_STORAGE_ZONE_NAME=""
BUNNY_STORAGE_ACCESS_KEY=""
# Region code for the storage endpoint ("" = Falkenstein default; "sg", "ny", "la", etc.)
BUNNY_STORAGE_REGION=""
BUNNY_STORAGE_PULL_ZONE=""
BUNNY_STORAGE_TOKEN_AUTH_KEY=""

# ---- Payment Gateway: Midtrans -----------------------------------------------
# Get these from https://dashboard.sandbox.midtrans.com → Settings → Access Keys.
# Leave SERVER/CLIENT keys empty in local dev to enable the simulated payment
# fallback (orders are marked SUCCESS without calling Midtrans).
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
# Same value as MIDTRANS_CLIENT_KEY — exposed to the browser for snap.js.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
MIDTRANS_MERCHANT_ID="Gxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# ---- Cron / Scheduled Jobs ---------------------------------------------------
# Shared secret protecting cron endpoints (e.g. /api/cron/expire-orders).
# Generate with: openssl rand -base64 32
CRON_SECRET="your-32-byte-base64-secret"

# ---- Business Configuration --------------------------------------------------
# Default certificate validity in years (empty = no expiry)
CERTIFICATE_DEFAULT_EXPIRY_YEARS="3"
# Internship attendance check-in window (24h, WIB)
ATTENDANCE_WINDOW_START="09:00"
ATTENDANCE_WINDOW_END="12:00"
