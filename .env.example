# =============================================================================
# NextLevel Academy — Environment Variables
# Copy this file to .env.local and fill in real values for local development.
# =============================================================================

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (Supabase PostgreSQL) ------------------------------------------
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (used by Prisma migrations / Prisma Studio)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ---- Supabase (Storage / public client) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ---- Better Auth -------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ---- Resend (Transactional Email) --------------------------------------------
# Free plan + no verified domain: use "onboarding@resend.dev" as the From
# address. With this setup Resend will ONLY deliver to the email address that
# owns the Resend account; sends to any other recipient return HTTP 403.
# To send to arbitrary recipients, verify a domain at resend.com/domains.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="NextLevel Academy <onboarding@resend.dev>"

# ---- Bunny.net (Video Streaming) ---------------------------------------------
BUNNY_STREAM_LIBRARY_ID="123456"
BUNNY_STREAM_API_KEY="your-bunny-stream-api-key"
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxxxxx-xxx.b-cdn.net"
# Used to generate signed URLs for protected video playback
BUNNY_STREAM_TOKEN_AUTH_KEY="your-bunny-token-auth-key"
# Optional: Bunny Storage for non-video assets (thumbnails, attachments)
BUNNY_STORAGE_ZONE_NAME="your-storage-zone"
BUNNY_STORAGE_ACCESS_KEY="your-bunny-storage-access-key"
BUNNY_STORAGE_REGION=""

# ---- Payment Gateway: DOKU ---------------------------------------------------
# Sandbox: https://api-sandbox.doku.com — Production: https://api.doku.com
DOKU_BASE_URL="https://api-sandbox.doku.com"
DOKU_CLIENT_ID="your-doku-client-id"
DOKU_SECRET_KEY="your-doku-secret-key"
DOKU_PRIVATE_KEY=""
DOKU_PARTNER_ID=""

# ---- Payment Gateway: Midtrans (alternative) ---------------------------------
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
MIDTRANS_MERCHANT_ID="Gxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# ---- Business Configuration --------------------------------------------------
# Default certificate validity in years (empty = no expiry)
CERTIFICATE_DEFAULT_EXPIRY_YEARS="3"
# Internship attendance check-in window (24h, WIB)
ATTENDANCE_WINDOW_START="09:00"
ATTENDANCE_WINDOW_END="12:00"
