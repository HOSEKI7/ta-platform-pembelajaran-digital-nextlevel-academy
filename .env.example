# =============================================================================
# NextLevel Academy — Environment Variables
# Copy this file to .env.local and fill in real values for local development.
# =============================================================================

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (Supabase PostgreSQL) ------------------------------------------
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct connection (used by Prisma migrations / Prisma Studio)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ---- Supabase (Storage / public client) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
# Public bucket used for user avatars (defaults to "avatars" if unset).
# Create the bucket in the Supabase dashboard and mark it as Public.
SUPABASE_AVATAR_BUCKET="avatars"

# ---- Better Auth -------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ---- Resend (Transactional Email) --------------------------------------------
# Free plan + no verified domain: use "onboarding@resend.dev" as the From
# address. With this setup Resend will ONLY deliver to the email address that
# owns the Resend account; sends to any other recipient return HTTP 403.
# To send to arbitrary recipients, verify a domain at resend.com/domains.
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="NextLevel Academy <onboarding@resend.dev>"

# ---- Bunny.net Stream (Video) ------------------------------------------------
# Setup:
#   1. Sign up at https://bunny.net and create a Stream Video Library
#   2. From the library dashboard, copy:
#        - Library ID (number, shown in the sidebar)            -> BUNNY_STREAM_LIBRARY_ID
#        - CDN Hostname ("vz-...b-cdn.net" in library settings) -> BUNNY_STREAM_CDN_HOSTNAME
#        - API Key (Settings -> API)                             -> BUNNY_STREAM_API_KEY (optional for now)
#   3. (Recommended) Enable Settings -> Security -> Token Authentication,
#      then copy the "Token Authentication Key"                  -> BUNNY_STREAM_TOKEN_AUTH_KEY
#      If left empty, the player loads the iframe without a token (use only in dev).
#   4. (Admin course upload) BUNNY_STREAM_API_KEY is now REQUIRED to create video
#      objects + sign direct TUS uploads from the admin "Tambah Kursus" page.
#   5. Set a webhook secret you choose, then in Bunny: Stream library -> Webhook
#      add URL "<APP_URL>/api/webhooks/bunny?secret=<BUNNY_WEBHOOK_SECRET>".
BUNNY_STREAM_LIBRARY_ID="123456"
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxxxxx-xxx.b-cdn.net"
BUNNY_STREAM_TOKEN_AUTH_KEY=""
# Shared secret validated as ?secret=... on the Bunny Stream encoding webhook.
BUNNY_WEBHOOK_SECRET=""

# ---- Bunny.net Storage (file blobs — task submissions, mentor attachments) ---
# Used by /internship/tasks for storing task submission files. Postgres (Supabase)
# only stores metadata/paths; physical blobs live here (cheaper + no 1 GB limit).
# Setup:
#   1. Bunny dashboard → Storage → Add Storage Zone. Note Zone name + Password (=AccessKey).
#   2. Bunny dashboard → CDN → Add Pull Zone pointing at the Storage Zone origin.
#      Note its hostname (e.g. "nla-internship.b-cdn.net").
#   3. (REQUIRED for private submissions) Pull Zone → Security → Token Authentication = ON.
#      Copy the Authentication Key. Also enable "Block Direct File Access".
# Leave blank in dev: uploads will fail with a clear "not configured" error.
BUNNY_STORAGE_ZONE_NAME=""
BUNNY_STORAGE_ACCESS_KEY=""
# Region code for the storage endpoint ("" = Falkenstein default; "sg", "ny", "la", etc.)
BUNNY_STORAGE_REGION=""
BUNNY_STORAGE_PULL_ZONE=""
BUNNY_STORAGE_TOKEN_AUTH_KEY=""

# ---- Bunny.net Storage (certificate PNGs — PUBLIC, tokenless) -----------------
# A SEPARATE storage + pull zone dedicated to certificate images. Kept apart from
# the private blob zone above so we can serve permanent, public, tokenless CDN
# URLs without weakening token auth on private files.
# Setup:
#   1. Bunny → Storage → Add Storage Zone (e.g. "nla-certificates").
#   2. Bunny → CDN → Add Pull Zone at that origin. Note its hostname.
#   3. Pull Zone → Security → Token Authentication = OFF (certificates are public
#      proof documents). Enumeration is prevented by the high-entropy path id.
# Leave blank in dev: cert PNG upload is skipped and the page lazy-regenerates.
BUNNY_CERT_STORAGE_ZONE_NAME=""
BUNNY_CERT_STORAGE_ACCESS_KEY=""
# Region code for the storage endpoint ("" = Falkenstein default; "sg", "ny", etc.)
BUNNY_CERT_STORAGE_REGION=""
# Public pull-zone hostname, e.g. "nla-certificates.b-cdn.net" (no protocol).
BUNNY_CERT_PULL_ZONE=""

# ---- Payment Gateway: Midtrans -----------------------------------------------
# Get these from https://dashboard.sandbox.midtrans.com → Settings → Access Keys.
# Leave SERVER/CLIENT keys empty in local dev to enable the simulated payment
# fallback (orders are marked SUCCESS without calling Midtrans).
#
# IMPORTANT — activate the payment channels you offer, or Snap shows
# "No payment channels available". The checkout method the user picks is passed
# to Snap as `enabled_payments` (a single channel), so that exact channel MUST
# be enabled in the dashboard: Settings → Snap Preferences → Payment Channels.
# Channels used by this app: QRIS, BCA/BRI/BNI/CIMB/Permata Virtual Account,
# Mandiri Bill (echannel), Other Bank VA (other_va), Indomaret, Alfamart, Akulaku.
#
# Local dev note: order status is reconciled against the Midtrans Get-Status API
# on read (payment page polling + transaction loaders), so payments are reflected
# even WITHOUT the webhook reaching localhost. The webhook (ngrok) stays the
# real-time path; reconciliation is the safety net.
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
# Same value as MIDTRANS_CLIENT_KEY — exposed to the browser for snap.js.
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
MIDTRANS_MERCHANT_ID="Gxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# ---- Cron / Scheduled Jobs ---------------------------------------------------
# Shared secret protecting cron endpoints (e.g. /api/cron/expire-orders).
# Generate with: openssl rand -base64 32
CRON_SECRET="your-32-byte-base64-secret"

# ---- Business Configuration --------------------------------------------------
# Default certificate validity in years (empty = no expiry)
CERTIFICATE_DEFAULT_EXPIRY_YEARS="3"
# Internship attendance check-in window (24h, WIB)
ATTENDANCE_WINDOW_START="09:00"
ATTENDANCE_WINDOW_END="12:00"

# ---- Rate Limiting (self-hosted Redis) ---------------------------------------
# Protects abuse-sensitive endpoints (POST /api/orders, /api/vouchers/validate).
#
# DEV (clone-and-run): leave RATE_LIMIT_REDIS_URL EMPTY. The limiter falls back
# to an in-memory store automatically — no Redis needed, the full app (incl.
# Snap purchase) works out of the box on any OS.
#
# Optional local Redis: `docker compose up -d redis`, set REDIS_PASSWORD below,
# then point the URL at it (note the leading ':' before the password — no user):
#   RATE_LIMIT_REDIS_URL="redis://:your-strong-password@127.0.0.1:6379"
#
# PRODUCTION (self-hosted VPS): run the compose service, set a strong password,
# keep port 6379 bound to 127.0.0.1 and closed to the public (firewall).
RATE_LIMIT_REDIS_URL=""
# Used by docker-compose.yml to set the Redis password. Keep in sync with the
# password embedded in RATE_LIMIT_REDIS_URL above.
REDIS_PASSWORD=""
