# =============================================================================
# NextLevel Academy — Environment Variables
# Copy this file to .env.local and fill in real values for local development.
# =============================================================================

# ---- App ---------------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# ---- Database (Supabase PostgreSQL) ------------------------------------------
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres"

# ---- Supabase (Storage / public client) --------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

SUPABASE_AVATAR_BUCKET="avatars"

# ---- Better Auth -------------------------------------------------------------
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="your-32-byte-base64-secret"
BETTER_AUTH_URL="http://localhost:3000"

# ---- Resend (Transactional Email) --------------------------------------------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="NextLevel Academy <onboarding@resend.dev>"

# ---- Bunny.net Stream (Video) ------------------------------------------------
BUNNY_STREAM_LIBRARY_ID="123456"
BUNNY_STREAM_API_KEY=""
BUNNY_STREAM_CDN_HOSTNAME="vz-xxxxxxxx-xxx.b-cdn.net"
BUNNY_STREAM_TOKEN_AUTH_KEY=""

BUNNY_WEBHOOK_SECRET=""

# ---- Bunny.net Storage (file blobs — task submissions, mentor attachments) ---
BUNNY_STORAGE_ZONE_NAME=""
BUNNY_STORAGE_ACCESS_KEY=""
BUNNY_STORAGE_REGION=""
BUNNY_STORAGE_PULL_ZONE=""
BUNNY_STORAGE_TOKEN_AUTH_KEY=""

# ---- Bunny.net Storage (certificate PNGs — PUBLIC, tokenless) -----------------
BUNNY_CERT_STORAGE_ZONE_NAME=""
BUNNY_CERT_STORAGE_ACCESS_KEY=""
BUNNY_CERT_STORAGE_REGION=""
BUNNY_CERT_PULL_ZONE=""

# ---- Payment Gateway: Midtrans -----------------------------------------------
MIDTRANS_SERVER_KEY="SB-Mid-server-xxxxxxxxxxxxxxxx"
MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY="SB-Mid-client-xxxxxxxxxxxxxxxx"
MIDTRANS_MERCHANT_ID="Gxxxxxxxxx"
MIDTRANS_IS_PRODUCTION="false"

# ---- Cron / Scheduled Jobs ---------------------------------------------------
CRON_SECRET="your-32-byte-base64-secret"

# ---- Administrator Accounts --------------------------------------------------
# First-admin bootstrap (scripts/bootstrap-admin.ts → `npm run bootstrap:admin`).
# Idempotent; the admin is forced to change this password at first login.
BOOTSTRAP_ADMIN_EMAIL="admin@nextlevel.local"
BOOTSTRAP_ADMIN_NAME="Admin NextLevel"
BOOTSTRAP_ADMIN_PASSWORD="ChangeMe123"
# Validity window (hours) for an admin email invitation link (default 24).
ADMIN_INVITE_EXPIRY_HOURS="24"

# ---- Business Configuration --------------------------------------------------
# Default certificate validity in years (empty = no expiry)
CERTIFICATE_DEFAULT_EXPIRY_YEARS="3"
# Internship attendance check-in window (24h, WIB)
ATTENDANCE_WINDOW_START="09:00"
ATTENDANCE_WINDOW_END="12:00"

# ---- Rate Limiting (self-hosted Redis) ---------------------------------------
# Backs BOTH the rate-limiter-flexible limiters (orders/voucher/admin-invite/
# change-email) AND Better Auth's auth-endpoint limiter (sign-in/up, password
# reset). When empty, both fall back to an in-memory store (dev). In production
# set this so brute-force windows survive restarts/deploys; if Redis goes down at
# runtime the auth limiter degrades to a strict in-memory net (never fail-open).
RATE_LIMIT_REDIS_URL=""
REDIS_PASSWORD=""
